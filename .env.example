# Fuso orario degli eventi creati
CALENDAR_TIMEZONE=Europe/Rome

# Supabase (Settings > API). Variabili pubbliche: sicure lato browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres (Settings > Database > Connection string > Transaction pooler, porta 6543).
# Usare il pooler in transaction mode: il client disattiva i prepared statement (prepare: false).
DATABASE_URL=
# Connessioni massime del pool per istanza (intero 1..50, default 10).
# DB_POOL_MAX=10

# Cifratura credenziali calendario (AES-256-GCM). Generare con: openssl rand -base64 32
# Cambiarla invalida le connessioni calendario salvate.
CALENDAR_ENCRYPTION_KEY=

# Google Calendar (OAuth 2.0 "Web application" su console.cloud.google.com, API Google Calendar abilitata)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
GOOGLE_CALENDAR_ID=primary

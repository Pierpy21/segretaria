# Fuso orario degli eventi creati
CALENDAR_TIMEZONE=Europe/Rome

# Google Calendar (OAuth 2.0 "Web application" su console.cloud.google.com, API Google Calendar abilitata)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
GOOGLE_CALENDAR_ID=primary

# Apple iCloud Calendar (CalDAV) — password specifica per app da appleid.apple.com
APPLE_ID=
APPLE_APP_PASSWORD=
# Nome del calendario iCloud da usare (vuoto = primo calendario eventi)
APPLE_CALENDAR_NAME=
